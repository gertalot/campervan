{
  "build_id": "@build_id@",
  "platform": "macOS arm64, deployment target 14.0, CPython 3.13",
  "configuration": "Release, C++17, static PIC, hidden visibility, no upstream tests or examples; see CMakeLists.txt for complete options",
  "options": {
    "common": "static, PIC, hidden visibility, arm64, macOS 14.0, C++17, Release; tests and examples off",
    "opencv": "core,imgproc,imgcodecs,features2d,flann,calib3d,photo,stitching,video,videoio,highgui,objdetect; vendored JPEG and PNG; GUI, video backends, OpenCL, CUDA, IPP and unused codecs disabled",
    "pcl": "common,io,octree,kdtree,search,surface,filters,registration,sample_consensus,segmentation and dependencies; VTK, Qt, CUDA, visualization, PNG, capture backends and OpenMP disabled",
    "g2o": "2D,3D,SBA,ICP,Sim3 types; Eigen, PCG, CSparse solvers; CHOLMOD, OpenGL, logging and apps disabled",
    "suitesparse": "suitesparse_config and cxsparse only; static, OpenMP disabled",
    "rtabmap": "core and utilite, g2o enabled; Qt, applications, tools, other optimizers and optional capture integrations disabled",
    "boost": "headers and static iostreams, SDK zlib only"
  },
