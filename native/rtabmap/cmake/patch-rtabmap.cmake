foreach(tool Export Reprocess)
  set(path "${SOURCE_DIR}/tools/${tool}/main.cpp")
  file(READ "${path}" contents)
  string(REPLACE "\r\n" "\n" contents "${contents}")
  string(REGEX MATCHALL "exit\\(1\\);" sites "${contents}")
  list(LENGTH sites count)
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "${tool} usage exit count changed: ${count}")
  endif()
  string(REPLACE "exit(1);" "throw std::runtime_error(\"Invalid ${tool} arguments\");" contents "${contents}")
  string(REGEX MATCHALL "Parameters::showUsage\\(\\)" parameter_sites "${contents}")
  list(LENGTH parameter_sites parameter_count)
  if(NOT parameter_count EQUAL 1)
    message(FATAL_ERROR "${tool} Parameters::showUsage count changed: ${parameter_count}")
  endif()
  string(REPLACE "showUsage(" "campervan_${tool}_usage(" contents "${contents}")
  string(REPLACE "Parameters::campervan_${tool}_usage(" "Parameters::showUsage(" contents "${contents}")
  set(contents "#include <stdexcept>\n${contents}")
  if(tool STREQUAL "Reprocess")
    set(entry "int main(int argc, char * argv[])\n{")
    set(reset "int main(int argc, char * argv[])\n{\n g_loopForever = true; loopCount = proxCount = loopCountMotion = loopInter = loopIntra = totalFrames = totalFramesMotion = 0;\n previousLocalizationDistances.clear(); odomDistances.clear(); localizationVariations.clear(); localizationAngleVariations.clear(); localizationTime.clear(); odomTrajectoryPoses.clear(); odomTrajectoryLinks.clear(); localizationPoses.clear(); exportPoses = false; sessionCount = 0;")
    string(FIND "${contents}" "${entry}" found)
    if(found EQUAL -1)
      message(FATAL_ERROR "Reprocess entry changed")
    endif()
    string(REPLACE "${entry}" "${reset}" contents "${contents}")
  endif()
  file(MAKE_DIRECTORY "${TOOL_DIR}")
  file(WRITE "${TOOL_DIR}/${tool}.cpp" "${contents}")
endforeach()
