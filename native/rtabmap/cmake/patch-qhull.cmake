file(SHA256 "${CMAKE_CURRENT_LIST_FILE}" actual_patch_hash)
if(NOT actual_patch_hash STREQUAL PATCH_INPUT_HASH)
  message(FATAL_ERROR "Qhull patch changed during the build; rerun make scan-native.")
endif()
file(READ "${SOURCE_DIR}/CMakeLists.txt" contents)
set(old "set(qhull_TARGETS_INSTALL \${qhull_TARGETS_APPLICATIONS})")
set(new "set_target_properties(qconvex qdelaunay qhalf qhull qvoronoi rbox testqset testqset_r user_eg user_eg2 user_eg3 PROPERTIES EXCLUDE_FROM_ALL TRUE)\nset(qhull_TARGETS_INSTALL)")
string(REPLACE "${old}" "" without_old "${contents}")
string(REPLACE "${new}" "" without_new "${contents}")
string(LENGTH "${contents}" total_length)
string(LENGTH "${without_old}" without_old_length)
string(LENGTH "${without_new}" without_new_length)
string(LENGTH "${old}" old_length)
string(LENGTH "${new}" new_length)
math(EXPR pristine_count "(${total_length} - ${without_old_length}) / ${old_length}")
math(EXPR patched_count "(${total_length} - ${without_new_length}) / ${new_length}")
if(pristine_count EQUAL 1 AND patched_count EQUAL 0)
  string(REPLACE "${old}" "${new}" contents "${contents}")
  file(WRITE "${SOURCE_DIR}/CMakeLists.txt" "${contents}")
elseif(pristine_count EQUAL 0 AND patched_count EQUAL 1)
  # Already applied by this patch; do not touch source timestamps.
else()
  message(FATAL_ERROR "Qhull install inventory changed. Remove "
    ".local/native-rtabmap/external/Source/qhull, .local/native-rtabmap/external/Build/qhull "
    "and the qhull-{mkdir,download,update,patch,configure,build,install,done} files under "
    ".local/native-rtabmap/external/Stamp/qhull, then rerun make scan-native.")
endif()
