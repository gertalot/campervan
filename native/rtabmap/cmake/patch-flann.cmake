file(READ "${SOURCE_DIR}/CMakeLists.txt" contents)
set(old "find_package(PkgConfig REQUIRED)\npkg_check_modules(LZ4 REQUIRED liblz4)")
string(FIND "${contents}" "${old}" site)
if(site EQUAL -1)
  message(FATAL_ERROR "FLANN LZ4 lookup changed")
endif()
set(new "find_path(LZ4_INCLUDE_DIRS lz4.h PATHS \"${PRIVATE_PREFIX}/include\" NO_DEFAULT_PATH REQUIRED)\nfind_library(LZ4_LIBRARIES lz4 PATHS \"${PRIVATE_PREFIX}/lib\" NO_DEFAULT_PATH REQUIRED)\nset(LZ4_LINK_LIBRARIES \${LZ4_LIBRARIES})")
string(REPLACE "${old}" "${new}" contents "${contents}")
string(REGEX MATCHALL "find_hdf5\\(\\)" sites "${contents}")
list(LENGTH sites count)
if(NOT count EQUAL 1)
  message(FATAL_ERROR "FLANN HDF5 discovery changed")
endif()
string(REPLACE "find_hdf5()" "set(HDF5_FOUND FALSE)" contents "${contents}")
file(WRITE "${SOURCE_DIR}/CMakeLists.txt" "${contents}")

set(cpp "${SOURCE_DIR}/src/cpp/CMakeLists.txt")
file(READ "${cpp}" contents)
set(old "TARGETS flann_cpp flann_cpp_s")
string(FIND "${contents}" "${old}" site)
if(site EQUAL -1)
  message(FATAL_ERROR "FLANN install target inventory changed")
endif()
string(REPLACE "${old}" "TARGETS flann_cpp_s" contents "${contents}")
string(REPLACE "set_target_properties(flann_cpp PROPERTIES\n" "set_target_properties(flann_cpp PROPERTIES EXCLUDE_FROM_ALL TRUE)\nset_target_properties(flann_cpp PROPERTIES\n" contents "${contents}")
file(WRITE "${cpp}" "${contents}")
