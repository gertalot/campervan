# Reapplying an unchanged patch must preserve the source timestamps. If an
# edited patch no longer matches either expected state, require a clean source.
file(SHA256 "${CMAKE_CURRENT_LIST_FILE}" actual_patch_hash)
if(NOT actual_patch_hash STREQUAL PATCH_INPUT_HASH)
  message(FATAL_ERROR "FLANN patch changed during the build; rerun make scan-native.")
endif()
function(replace_checked variable old new description)
  string(FIND "${${variable}}" "${new}" patched)
  string(FIND "${${variable}}" "${old}" pristine)
  if(NOT patched EQUAL -1)
    string(REPLACE "${new}" "" remaining "${${variable}}")
    string(FIND "${remaining}" "${old}" extra_old)
    string(LENGTH "${${variable}}" total_length)
    string(LENGTH "${remaining}" remaining_length)
    string(LENGTH "${new}" match_length)
    math(EXPR match_count "(${total_length} - ${remaining_length}) / ${match_length}")
    if(match_count EQUAL 1 AND extra_old EQUAL -1)
      return()
    endif()
  elseif(NOT pristine EQUAL -1)
    string(REPLACE "${old}" "" remaining "${${variable}}")
    string(LENGTH "${${variable}}" total_length)
    string(LENGTH "${remaining}" remaining_length)
    string(LENGTH "${old}" match_length)
    math(EXPR match_count "(${total_length} - ${remaining_length}) / ${match_length}")
    if(match_count EQUAL 1)
      string(REPLACE "${old}" "${new}" updated "${${variable}}")
      set(${variable} "${updated}" PARENT_SCOPE)
      return()
    endif()
  endif()
    message(FATAL_ERROR "FLANN ${description} changed. Remove "
      ".local/native-rtabmap/external/Source/flann, .local/native-rtabmap/external/Build/flann "
      "and the flann-{mkdir,download,update,patch,configure,build,install,done} files under "
      ".local/native-rtabmap/external/Stamp/flann, then rerun make scan-native.")
endfunction()

file(READ "${SOURCE_DIR}/CMakeLists.txt" contents)
set(original "${contents}")
set(old "find_package(PkgConfig REQUIRED)\npkg_check_modules(LZ4 REQUIRED liblz4)")
set(new "find_path(LZ4_INCLUDE_DIRS lz4.h PATHS \"${PRIVATE_PREFIX}/include\" NO_DEFAULT_PATH REQUIRED)\nfind_library(LZ4_LIBRARIES lz4 PATHS \"${PRIVATE_PREFIX}/lib\" NO_DEFAULT_PATH REQUIRED)\nset(LZ4_LINK_LIBRARIES \${LZ4_LIBRARIES})")
replace_checked(contents "${old}" "${new}" "LZ4 lookup")
replace_checked(contents "find_hdf5()" "set(HDF5_FOUND FALSE)" "HDF5 discovery")
if(NOT contents STREQUAL original)
  file(WRITE "${SOURCE_DIR}/CMakeLists.txt" "${contents}")
endif()

